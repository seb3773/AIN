@ECHO OFF
SET AIN_SW=/Y
DEL *.AIN
DEL *.A01
DEL *.A02
DEL *.A03
ECHO Creating AIN 2.22 archives...

AIN A /M1 /Y HELLO1.AIN HELLO.TXT
AIN A /M2 /Y HELLO2.AIN HELLO.TXT
AIN A /M3 /Y HELLO3.AIN HELLO.TXT
AIN A /M4 /Y HELLO4.AIN HELLO.TXT

AIN A /M1 /Y ENG1.AIN ENG.TXT
AIN A /M2 /Y ENG2.AIN ENG.TXT
AIN A /M3 /Y ENG3.AIN ENG.TXT
AIN A /M4 /Y ENG4.AIN ENG.TXT

AIN A /M1 /Y EMPTY1.AIN EMPTY.DAT
AIN A /M3 /Y EMPTY3.AIN EMPTY.DAT
AIN A /M4 /Y EMPTY4.AIN EMPTY.DAT

AIN A /M3 /Y ZEROS3.AIN ZEROS.BIN
AIN A /M4 /Y ZEROS4.AIN ZEROS.BIN

AIN A /M1 /Y MIXED1.AIN MIXED.BIN
AIN A /M2 /Y MIXED2.AIN MIXED.BIN
AIN A /M3 /Y MIXED3.AIN MIXED.BIN

AIN A /M1 /Y IMAGE1.AIN IMAGE.RAW
AIN A /M3 /Y IMAGE3.AIN IMAGE.RAW

AIN A /M1 /Y CODE1.AIN CODE.C

AIN A /M2 /Y MULTI.AIN HELLO.TXT ENG.TXT MIXED.BIN CODE.C

AIN A /M1 /R /Y NESTED.AIN NESTED\*.*

AIN A /F50K /M3 /Y FRAG.AIN ENG.TXT MIXED.BIN IMAGE.RAW HELLO.TXT

AIN L HELLO1.AIN > LHELLO1.TXT
AIN L MULTI.AIN > LMULTI.TXT
AIN L NESTED.AIN > LNESTED.TXT
AIN T HELLO1.AIN > THELLO1.TXT
AIN T MULTI.AIN > TMULTI.TXT
AIN T NESTED.AIN > TNESTED.TXT

DIR *.AIN > DIRAIN.TXT
DIR *.A0? >> DIRAIN.TXT
ECHO ALLDONE > DONE.TXT
