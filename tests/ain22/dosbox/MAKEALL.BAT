@ECHO OFF
SET AIN_SW=/Y
AIN A /M1 /Y HELLO1.AIN HELLO.TXT
AIN A /M2 /Y HELLO2.AIN HELLO.TXT
AIN A /M3 /Y HELLO3.AIN HELLO.TXT
AIN A /M4 /Y HELLO4.AIN HELLO.TXT
AIN A /M1 /Y ENG1.AIN ENG.TXT
AIN A /M2 /Y ENG2.AIN ENG.TXT
AIN A /M3 /Y ENG3.AIN ENG.TXT
AIN A /M4 /Y ENG4.AIN ENG.TXT
AIN A /M1 /Y EMPTY1.AIN EMPTY.DAT
AIN A /M3 /Y EMPTY3.AIN EMPTY.DAT
AIN A /M4 /Y EMPTY4.AIN EMPTY.DAT
AIN A /M3 /Y ZEROS3.AIN ZEROS.BIN
AIN A /M4 /Y ZEROS4.AIN ZEROS.BIN
AIN A /M1 /Y MIXED1.AIN MIXED.BIN
AIN A /M2 /Y MIXED2.AIN MIXED.BIN
AIN A /M3 /Y MIXED3.AIN MIXED.BIN
